# Copy to .env and replace every change-me value before deployment.
POSTGRES_DB=ai_studymate
POSTGRES_USER=ai_studymate
POSTGRES_PASSWORD=change-me-database-password
JWT_SECRET_KEY=change-me-with-at-least-32-random-characters
GEMINI_API_KEY=

FRONTEND_PORT=8080
CORS_ORIGINS=["http://localhost:8080"]
LOG_LEVEL=INFO
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CONCURRENT_REQUESTS=4
EMBEDDING_PROVIDER=local
MAX_PDF_SIZE_MB=20
FLASHCARD_MIN_CARDS=1
FLASHCARD_MAX_CARDS=30
FLASHCARD_CONTEXT_TOP_K=20
FLASHCARD_CONTEXT_MAX_CHARS=50000
FLASHCARD_MAX_OUTPUT_TOKENS=6144
PLANNER_MAX_STEPS=10
PLANNER_MAX_RETRIES=1
PLANNER_TIMEOUT_SECONDS=90
PLANNER_CONTEXT_TOP_K=12
TUTOR_MAX_STEPS=8
TUTOR_TIMEOUT_SECONDS=60
TUTOR_HISTORY_MESSAGES=10
TUTOR_HISTORY_MAX_CHARS=12000
TUTOR_CONTEXT_TOP_K=6
TUTOR_CONTEXT_MAX_CHARS=24000
