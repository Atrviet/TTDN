# Application
APP_NAME=AI StudyMate
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (development values only; change passwords outside local development)
POSTGRES_DB=ai_studymate
POSTGRES_USER=ai_studymate
POSTGRES_PASSWORD=ai_studymate_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://ai_studymate:ai_studymate_dev_password@localhost:5433/ai_studymate
# Optional, required only for destructive PostgreSQL integration tests.
# The database name must contain "test" and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://ai_studymate:ai_studymate_dev_password@localhost:5433/ai_studymate_test

# Authentication (replace before implementing or running authentication)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ai-studymate
JWT_AUDIENCE=ai-studymate-api

# AI and vector storage (not used in STEP 01)
GEMINI_API_KEY=
CHROMA_PERSIST_DIR=./chroma_data

# PDF document storage
DOCUMENT_STORAGE_DIR=./document_storage
MAX_PDF_SIZE_MB=20

