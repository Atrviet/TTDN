# Application
APP_NAME=AI StudyMate
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL (development values only; change passwords outside local development)
POSTGRES_DB=ai_studymate
POSTGRES_USER=ai_studymate
POSTGRES_PASSWORD=ai_studymate_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://ai_studymate:ai_studymate_dev_password@localhost:5433/ai_studymate
# Optional, required only for destructive PostgreSQL integration tests.
# The database name must contain "test" and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://ai_studymate:ai_studymate_dev_password@localhost:5433/ai_studymate_test

# Authentication (replace before implementing or running authentication)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ai-studymate
JWT_AUDIENCE=ai-studymate-api

# AI and vector storage (not used in STEP 01)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=1024
CHROMA_PERSIST_DIR=./chroma_data

# RAG indexing and embedding
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_COLLECTION_PREFIX=ai_studymate_chunks_v1
RAG_MAX_TOP_K=20
CHAT_RAG_TOP_K=5
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_MAX_CHARS=12000
CHAT_CONTEXT_MAX_CHARS=24000

# LangGraph study agent
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=60
AGENT_HISTORY_MESSAGES=8
AGENT_CONTEXT_MAX_CHARS=30000

# AI quiz generation
QUIZ_MIN_QUESTIONS=1
QUIZ_MAX_QUESTIONS=10
QUIZ_CONTEXT_TOP_K=12
QUIZ_CONTEXT_MAX_CHARS=40000
QUIZ_MAX_OUTPUT_TOKENS=4096

# PDF document storage
DOCUMENT_STORAGE_DIR=./document_storage
MAX_PDF_SIZE_MB=20

